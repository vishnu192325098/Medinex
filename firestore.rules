rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile and all user subcollections (reminders, scanHistory, prescriptions, stockPredictions)
    // are strictly restricted to the authenticated owner.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
