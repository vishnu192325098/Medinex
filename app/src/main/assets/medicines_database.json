  "interactions": [
    {
      "drug1": "aspirin",
      "drug2": "warfarin",
      "risk_level": "HIGH",
      "description": "These medicines significantly increase internal bleeding risks.",
      "recommendation": "Consult doctor immediately before combining blood thinners."
    },
    {
      "drug1": "ibuprofen",
      "drug2": "aspirin",
      "risk_level": "MEDIUM",
      "description": "Ibuprofen may reduce Aspirin's cardioprotective effect and increase stomach irritation.",
      "recommendation": "Use with caution under medical supervision."
    },
    {
      "drug1": "azithromycin",
      "drug2": "levocetirizine",
      "risk_level": "MEDIUM",
      "description": "May cause enhanced drowsiness and dizziness when taken simultaneously.",
      "recommendation": "Avoid operating heavy machinery or driving after taking both."
    },
    {
      "drug1": "paracetamol",
      "drug2": "cetirizine",
      "risk_level": "LOW",
      "description": "No significant adverse interaction identified.",
      "recommendation": "Generally safe when taken as directed."
    },
    {
      "drug1": "aceclofenac",
      "drug2": "warfarin",
      "risk_level": "HIGH",
      "description": "Combining NSAIDs like Aceclofenac with blood thinners significantly increases gastrointestinal and systemic bleeding risks.",
      "recommendation": "Avoid combination unless strictly monitored by your physician."
    },
    {
      "drug1": "aceclofenac",
      "drug2": "aspirin",
      "risk_level": "MEDIUM",
      "description": "Concurrent use increases the risk of serious gastrointestinal ulceration and reduces cardioprotective efficacy.",
      "recommendation": "Consult a healthcare professional before taking together."
    },
    {
      "drug1": "sacubitril + valsartan",
      "drug2": "losartan",
      "risk_level": "HIGH",
      "description": "Dual angiotensin receptor blockade increases risk of severe hypotension, syncope, hyperkalemia, and renal impairment.",
      "recommendation": "Do not combine ARBs with Sacubitril/Valsartan."
    },
    {
      "drug1": "sacubitril + valsartan",
      "drug2": "telmisartan",
      "risk_level": "HIGH",
      "description": "Dual angiotensin blockade increases risk of severe hypotension, hyperkalemia, and renal dysfunction.",
      "recommendation": "Do not co-administer ARBs with Sacubitril/Valsartan."
    }
  ]
