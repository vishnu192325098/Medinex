<?xml version="1.0" encoding="utf-8"?>

<shape xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Glass Background -->
    <solid android:color="@color/glass_white"/>

    <!-- Rounded Corners -->
    <corners android:radius="24dp"/>

    <!-- Soft Border -->
    <stroke
        android:width="1dp"
        android:color="@color/glass_light"/>

    <!-- Inner Padding -->
    <padding
        android:left="16dp"
        android:right="16dp"
        android:top="16dp"
        android:bottom="16dp"/>

</shape>