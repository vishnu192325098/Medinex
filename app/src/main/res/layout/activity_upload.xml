<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/login_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI Prescription Scanner"
                    android:textColor="@color/text_primary"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/infoText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Turn your prescription into intelligent medicine information"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>

            <TextView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/profile_circle"
                android:gravity="center"
                android:text="✦"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- AI SCANNER HERO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/header_gradient"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Smart Prescription Scan"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Upload a prescription and let Medinex AI analyze it."
                    android:textColor="#E8F4FF"
                    android:textSize="12sp" />

            </LinearLayout>

            <TextView
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:gravity="center"
                android:text="✦"
                android:textColor="@android:color/white"
                android:textSize="30sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- SECTION TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Upload Prescription"
            android:textColor="@color/text_primary"
            android:textSize="21sp"
            android:textStyle="bold" />


        <!-- UPLOAD CARD -->
        <LinearLayout
            android:id="@+id/uploadCard"
            android:layout_width="match_parent"
            android:layout_height="245dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/glass_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:id="@+id/prescriptionImage"
                android:layout_width="105dp"
                android:layout_height="105dp"
                android:padding="18dp"
                android:src="@drawable/ic_upload"
                android:contentDescription="Prescription upload" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Upload your prescription"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="JPG, PNG or prescription image"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

        </LinearLayout>


        <!-- SELECT BUTTON -->
        <Button
            android:id="@+id/selectImageBtn"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/button_gradient"
            android:backgroundTint="@null"
            android:text="＋  Select Prescription"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />


        <!-- ANALYZE BUTTON -->
        <Button
            android:id="@+id/scanBtn"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/glass_button"
            android:backgroundTint="@null"
            android:text="✦  Analyze with Medinex AI"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- VIEW HISTORY BUTTON -->
        <Button
            android:id="@+id/viewHistoryBtn"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/glass_card"
            android:backgroundTint="@null"
            android:text="📋  View Scan History"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />


        <!-- RESULT SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="AI Analysis"
                    android:textColor="@color/text_primary"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MEDINEX AI"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- RESULTS CARD -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="220dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/glass_card"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/resultText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp"
                    android:text="📋  AI analysis results will appear here..."
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:lineSpacingExtra="5dp" />

            </ScrollView>

        </LinearLayout>


        <!-- FOOTER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="25dp"
            android:text="MEDINEX  •  AI PRESCRIPTION INTELLIGENCE"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>