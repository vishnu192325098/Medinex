<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D9F3FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📘 About Medinex"
            android:textSize="34sp"
            android:textStyle="bold"
            android:textColor="#102A43"
            android:layout_marginTop="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI-powered healthcare assistance"
            android:textColor="#64748B"
            android:textSize="15sp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="25dp"/>

        <!-- About Card -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/health_hub_card"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏥 What is Medinex?"
                android:textColor="#102A43"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Medinex is an AI-powered healthcare assistant designed to help patients manage medicines, reminders, prescriptions, stock prediction, diet planning, and health monitoring. The system uses intelligent healthcare modules to improve medication safety and patient awareness."
                android:textColor="#334E68"
                android:textSize="17sp"
                android:lineSpacingExtra="5dp"
                android:layout_marginTop="15dp"/>

        </LinearLayout>

        <!-- Features Card -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/health_hub_card"
            android:orientation="vertical"
            android:padding="22dp"
            android:layout_marginTop="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨ Medinex Features"
                android:textColor="#102A43"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💊 Medicine Management&#10;&#10;⏰ Medicine Reminders&#10;&#10;📋 AI Prescription Scanner&#10;&#10;📦 Medicine Stock Prediction&#10;&#10;🥗 Diet Planning&#10;&#10;🩺 Health Monitoring"
                android:textColor="#334E68"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="15dp"/>

        </LinearLayout>

        <!-- Mission Card -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/health_hub_card"
            android:orientation="vertical"
            android:padding="22dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="25dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💙 Our Goal"
                android:textColor="#102A43"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="To make everyday healthcare management simpler, safer, and more accessible through intelligent digital tools."
                android:textColor="#334E68"
                android:textSize="17sp"
                android:lineSpacingExtra="5dp"
                android:layout_marginTop="15dp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>