<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D9F3FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🥗 Diet Planner"
            android:textColor="#102A43"
            android:textSize="34sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Personalized diet recommendations"
            android:textColor="#64748B"
            android:textSize="15sp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="25dp" />

        <!-- Nutrition AI Card -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="@drawable/health_hub_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🥗"
                android:textSize="32sp"
                android:layout_marginEnd="15dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MEDINEX NUTRITION AI"
                    android:textColor="#0088CC"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Create a personalized food plan"
                    android:textColor="#102A43"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="5dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Health Condition Card -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/health_hub_card"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginTop="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Health Condition"
                android:textColor="#102A43"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tell us about your current condition"
                android:textColor="#64748B"
                android:textSize="14sp"
                android:layout_marginTop="5dp" />

            <!-- Input Box -->

            <EditText
                android:id="@+id/conditionInput"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/input_box"
                android:hint="e.g. Fever, Diabetes, Dengue"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#102A43"
                android:textColorHint="#64748B"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- Generate Button -->

        <Button
            android:id="@+id/generateBtn"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/button_gradient"
            android:backgroundTint="@null"
            android:text="Generate Diet Plan"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Result Card -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/health_hub_card"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍎 Diet Recommendation"
                android:textColor="#102A43"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your personalized nutrition plan"
                android:textColor="#64748B"
                android:textSize="14sp"
                android:layout_marginTop="5dp" />

            <TextView
                android:id="@+id/resultText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your diet plan will appear here after analysis."
                android:textColor="#102A43"
                android:textSize="16sp"
                android:layout_marginTop="18dp" />

        </LinearLayout>

        <!-- Disclaimer -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Medinex recommendations are for general guidance and should not replace professional medical advice."
            android:textColor="#64748B"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="25dp" />

    </LinearLayout>

</ScrollView>