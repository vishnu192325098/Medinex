<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D9F3FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🍎 Apple Health Advisor"
            android:textColor="#102A43"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- Subtitle -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Get fruit recommendations and first aid tips"
            android:textColor="#64748B"
            android:textSize="15sp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="20dp"/>

        <!-- Condition Input Card -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/health_hub_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🩺 Health Condition"
                android:textColor="#102A43"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/conditionInput"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="12dp"
                android:hint="Enter condition (Fever, Cold, Dengue...)"
                android:textColor="#102A43"
                android:textColorHint="#64748B"
                android:background="@drawable/input_box"
                android:padding="16dp"/>

        </LinearLayout>

        <!-- Get Advice Button -->

        <Button
            android:id="@+id/generateBtn"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="20dp"
            android:text="Get Advice"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/button_gradient"
            android:backgroundTint="@null"/>

        <!-- Result Card -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/health_hub_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍎 Health Advice"
                android:textColor="#102A43"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/resultText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Your health advice will appear here..."
                android:textColor="#64748B"
                android:textSize="16sp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>